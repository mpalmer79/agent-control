// Agent Control: Prisma schema.
//
// Models the core entities from DATA_MODEL.md. PostgreSQL is the source of
// truth. Every tenant-owned model carries an organizationId and is scoped by
// organization. Audit events, cost records, and outbox events are append-only
// by convention enforced in the service layer.
//
// Primary keys are UUIDs. Controlled status values use enums. JSON is used only
// where flexibility is justified (config snapshots, prompt variables, audit
// state snapshots, and event payloads). AuditEvent.action is a string because
// audit action names follow the resource.action dot convention from
// AUDIT_MODEL.md, which a database enum cannot represent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMINISTRATOR
  PLATFORM_ENGINEER
  REVIEWER
  AUDITOR
  EXECUTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AgentRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum PromptVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum ModelProviderStatus {
  ACTIVE
  DISABLED
}

enum ModelStatus {
  ENABLED
  DISABLED
  DEPRECATED
}

enum DeploymentStatus {
  REQUESTED
  PENDING_APPROVAL
  ACTIVE
  SUPERSEDED
  ROLLED_BACK
  BLOCKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
}

enum EvaluationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity and tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  agents       Agent[]
  prompts      Prompt[]
  approvals    Approval[]
  auditEvents  AuditEvent[]
  costRecords  CostRecord[]
  incidents    Incident[]
  environments Environment[]
  outboxEvents OutboxEvent[]
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String
  fullName       String
  role           UserRole
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownedAgents        Agent[]      @relation("AgentOwner")
  requestedApprovals Approval[]   @relation("ApprovalRequestedBy")
  assignedApprovals  Approval[]   @relation("ApprovalAssignedTo")
  auditEvents        AuditEvent[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Environment {
  id             String          @id @default(uuid())
  organizationId String
  name           EnvironmentType
  description    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model Agent {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  ownerUserId    String
  status         AgentStatus    @default(DRAFT)
  riskLevel      AgentRiskLevel @default(LOW)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User           @relation("AgentOwner", fields: [ownerUserId], references: [id])
  versions     AgentVersion[]
  deployments  Deployment[]
  incidents    Incident[]
  costRecords  CostRecord[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model AgentVersion {
  id              String   @id @default(uuid())
  agentId         String
  version         String
  promptVersionId String?
  modelId         String?
  configJson      Json?
  createdBy       String
  createdAt       DateTime @default(now())

  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  promptVersion  PromptVersion?  @relation(fields: [promptVersionId], references: [id])
  model          Model?          @relation(fields: [modelId], references: [id])
  deployments    Deployment[]
  evaluationRuns EvaluationRun[]

  @@unique([agentId, version])
  @@index([agentId])
}

// ---------------------------------------------------------------------------
// Prompts
// ---------------------------------------------------------------------------

model Prompt {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     PromptVersion[]

  @@index([organizationId])
}

model PromptVersion {
  id            String              @id @default(uuid())
  promptId      String
  version       String
  status        PromptVersionStatus @default(DRAFT)
  templateText  String
  variablesJson Json?
  changeReason  String?
  createdBy     String
  createdAt     DateTime            @default(now())

  prompt        Prompt         @relation(fields: [promptId], references: [id], onDelete: Cascade)
  agentVersions AgentVersion[]

  @@unique([promptId, version])
  @@index([promptId])
}

// ---------------------------------------------------------------------------
// Models and providers
// ---------------------------------------------------------------------------

model ModelProvider {
  id        String              @id @default(uuid())
  key       String              @unique
  name      String
  status    ModelProviderStatus @default(ACTIVE)
  createdAt DateTime            @default(now())

  models Model[]
}

model Model {
  id                   String         @id @default(uuid())
  providerId           String
  modelKey             String
  displayName          String
  contextWindow        Int
  inputCostPerMillion  Float
  outputCostPerMillion Float
  riskLevel            AgentRiskLevel @default(MEDIUM)
  status               ModelStatus    @default(ENABLED)
  enabledForProduction Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  provider      ModelProvider  @relation(fields: [providerId], references: [id])
  agentVersions AgentVersion[]
  costRecords   CostRecord[]

  @@unique([providerId, modelKey])
}

// ---------------------------------------------------------------------------
// Deployments
// ---------------------------------------------------------------------------

model Deployment {
  id                     String           @id @default(uuid())
  agentId                String
  agentVersionId         String
  environment            EnvironmentType
  status                 DeploymentStatus @default(REQUESTED)
  deployedBy             String
  approvedBy             String?
  deployedAt             DateTime?
  rollbackFromDeployment String?
  correlationId          String
  createdAt              DateTime         @default(now())

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id])

  @@index([agentId])
  @@index([agentId, environment])
}

// ---------------------------------------------------------------------------
// Governance
// ---------------------------------------------------------------------------

model Approval {
  id             String         @id @default(uuid())
  organizationId String
  resourceType   String
  resourceId     String
  requestedBy    String
  assignedTo     String?
  status         ApprovalStatus @default(PENDING)
  decisionReason String?
  decidedAt      DateTime?
  correlationId  String
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  assignee     User?        @relation("ApprovalAssignedTo", fields: [assignedTo], references: [id])

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Evaluations
// ---------------------------------------------------------------------------

model EvaluationRun {
  id             String           @id @default(uuid())
  agentVersionId String
  suiteName      String
  status         EvaluationStatus @default(QUEUED)
  score          Float?
  passed         Boolean?
  startedAt      DateTime?
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime         @default(now())

  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([agentVersionId])
}

// ---------------------------------------------------------------------------
// Observability and incidents
// ---------------------------------------------------------------------------

model Incident {
  id             String           @id @default(uuid())
  organizationId String
  agentId        String?
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  title          String
  description    String?
  correlationId  String
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id])

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Costs (append-only)
// ---------------------------------------------------------------------------

model CostRecord {
  id             String          @id @default(uuid())
  organizationId String
  agentId        String?
  modelId        String?
  provider       String
  inputTokens    Int
  outputTokens   Int
  estimatedCost  Float
  environment    EnvironmentType
  correlationId  String
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id])
  model        Model?       @relation(fields: [modelId], references: [id])

  @@index([organizationId, createdAt])
  @@index([agentId])
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

model AuditEvent {
  id                String   @id @default(uuid())
  organizationId    String
  actorUserId       String?
  action            String
  resourceType      String
  resourceId        String
  previousStateJson Json?
  newStateJson      Json?
  correlationId     String
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([correlationId])
}

// ---------------------------------------------------------------------------
// Outbox (append-only, transactional event delivery)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id             String            @id @default(uuid())
  organizationId String
  eventType      String
  aggregateType  String
  aggregateId    String
  payloadJson    Json
  correlationId  String
  status         OutboxEventStatus @default(PENDING)
  occurredAt     DateTime          @default(now())
  publishedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, occurredAt])
}
