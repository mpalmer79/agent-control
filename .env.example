# Agent Control environment configuration (example)
#
# Copy this file to .env and fill in values for local development.
# Use safe placeholders here. Never commit real secrets.
# .env is ignored by git; only .env.example is tracked.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=agent-control
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL is the source of truth)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/agent_control
DATABASE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Cache (optional, Redis is never the source of truth)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication (Clerk)
# Provide values from your Clerk application. Never commit real keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Runtime mode
# simulated: MVP default, no live provider calls.
# admin: protected mode that enables real provider calls (operator supplied keys).
# ---------------------------------------------------------------------------
RUNTIME_MODE=simulated

# ---------------------------------------------------------------------------
# Provider adapters (leave blank in simulated mode)
# Only populate behind the protected admin mode. Never commit real keys.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Object storage (optional, for exports and large artifacts)
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=agent-control-artifacts
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Observability (optional in MVP)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-control

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_ORGANIZATION_SLUG=demo-org
